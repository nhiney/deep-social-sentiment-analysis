# =========================
# ML / DL artifacts
# =========================

# ── Data files: tất cả đều nhỏ (< 10 MB) → track trực tiếp ───────────────
# Không có rule ignore cho data/ nữa — mọi file đều được git track.
# Ngoại lệ duy nhất: file tạm sinh ra khi chạy (nếu có)
data/processed/pseudo_labeled_apify.csv   # sinh ra bởi pseudo_label_apify.py — có thể lớn

# ── Model weights ─────────────────────────────────────────────────────────
# pytorch_model.bin / model.safetensors sau training ~ 500 MB → dùng Git LFS.
# Config, tokenizer nhỏ → track bình thường (rule !models/**/*.json bên dưới).
models/*
!models/.gitkeep
!models/**/*.json
!models/**/*.txt
!models/**/*.yaml
!models/**/*.yml
# Weights lớn: chạy `git lfs track "*.bin"` trước khi push
*.pt
*.pth
*.ckpt
*.h5
*.onnx
*.pkl
*.joblib

# Reports/figures — track để hiện trong README
reports/figures/*
!reports/figures/.gitkeep

# Logs / experiment tracking
logs/
runs/
wandb/
mlruns/
lightning_logs/
tb_logs/
outputs/
reports/figures/*
!reports/figures/.gitkeep

# HuggingFace cache
.cache/
hf_cache/
transformers_cache/

# =========================
# Testing & coverage
# =========================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
nosetests.xml

# =========================
# Environment variables / secrets
# =========================
.env
.env.*
!.env.example
*.pem
*.key

# =========================
# Misc
# =========================
*.log
*.tmp
*.bak
node_modules/
